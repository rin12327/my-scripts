local function updatePlayers()
    local plist = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(plist, {label = p.DisplayName .. " (@" .. p.Name .. ")", player = p})
        end
    end
    refreshTarget(plist)
end
targetBtn.MouseButton1Click:Connect(updatePlayers)

