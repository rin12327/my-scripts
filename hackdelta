-- LOGIC BACKEND (NOCLIP & ATTACK)
---------------------------------------------------------

RunService.Stepped:Connect(function()
    if noclipActive and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = targetPlayer.Character.HumanoidRootPart
            local myHRP = myChar.HumanoidRootPart

            local targetCF = targetHRP.CFrame
            local posBehind = targetCF.Position - (targetCF.LookVector * behindDist)
            local finalPos = posBehind - Vector3.new(0, underDist, 0)

            myHRP.CFrame = CFrame.lookAt(finalPos, targetHRP.Position) * CFrame.Angles(math.rad(-90), 0, 0)
        end
    end
end)

-- Loop Đánh Thường TSB
task.spawn(function()
    while true do
        task.wait(0.25)
        if autoAttack and targetPlayer then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)

                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then comm:FireServer({Goal = "LeftClick"}) end
                end
            end)
        end
    end
end)

-- Loop Spam Skill TSB (1, 2, 3, 4)
task.spawn(function()
    local skillIndex = 1
    local keys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    while true do
        task.wait(1.0)
        if autoAttack and targetPlayer then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, keys[skillIndex], false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, keys[skillIndex], false, game)

                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then comm:FireServer({Goal = "KeyPress", Key = keys[skillIndex]}) end
                end
            end)
            skillIndex = (skillIndex % 4) + 1
        end
    end
end)
