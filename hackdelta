local function cleanObject(obj)
    if not obj then return end
    pcall(function()
        if obj:IsA("BasePart") and not Players:GetPlayerFromCharacter(obj.Parent) then
            -- Mảnh vỡ/đất đá văng ra từ chiêu thức sẽ bị dọn ngay
            if obj.Name:lower():find("debris") or obj.Name:lower():find("rock") or obj.Name:lower():find("part") or obj.Name:lower():find("fx") then
                obj:Destroy()
            else
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            obj:Destroy()
        end
    end)
end

AntiLagBtn.MouseButton1Click:Connect(function()
    autoDestroyParts = true
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") or obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect") then
                obj.Enabled = false
            end
        end

        for _, v in ipairs(Workspace:GetDescendants()) do
            cleanObject(v)
        end
    end)
    AntiLagBtn.Text = "💥 Auto Xóa Khối Văng: ON!"
    AntiLagBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
end)

