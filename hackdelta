local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

-- 1. TẠO SÀN BẢO VỆ CHỐNG RƠI VOID
local antiVoidFloor = Workspace:FindFirstChild("AntiVoidSafetyFloor")
if not antiVoidFloor then
    antiVoidFloor = Instance.new("Part")
    antiVoidFloor.Name = "AntiVoidSafetyFloor"
    antiVoidFloor.Size = Vector3.new(200000, 20, 200000)
    antiVoidFloor.Position = Vector3.new(0, -20, 0)
    antiVoidFloor.Anchored = true
    antiVoidFloor.CanCollide = true
    antiVoidFloor.Material = Enum.Material.SmoothPlastic
    antiVoidFloor.Transparency = 1 -- Sàn vô hình
    antiVoidFloor.Parent = Workspace
end

-- 2. TẮT ÁNH SÁNG, BẦU TRỜI, MÂY, BÓNG ĐỔ, TẠO MÔI TRƯỜNG PHẲNG
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 1
    Lighting.ClockTime = 12
    
    -- Xóa bầu trời, mây và các effect trong Lighting
    for _, item in ipairs(Lighting:GetChildren()) do
        if item:IsA("Sky") or item:IsA("Clouds") or item:IsA("PostEffect") or item:IsA("Atmosphere") then
            item:Destroy()
        end
    end

    -- Xóa Terrain (Địa hình 3D)
    if Workspace.Terrain then
        Workspace.Terrain:Clear()
    end
end)

-- 3. HÀM XÓA PHỤ KIỆN & HIỆU ỨNG TRÊN NHÂN VẬT
local function cleanCharacter(char)
    if not char then return end
    
    -- Xóa phụ kiện (mũ, cánh, trang phục 3D...)
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Accoutrement") then
            item:Destroy()
        end
    end
    
    -- Lầm mịn vật liệu các bộ phận và xóa VFX dính trên người
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Material = Enum.Material.SmoothPlastic
            desc.Reflectance = 0
        elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Smoke") or desc:IsA("Fire") or desc:IsA("Sparkles") or desc:IsA("Highlight") then
            desc:Destroy()
        end
    end
end

-- 4. HÀM LỌC VÀ XÓA TOÀN BỘ MAP / KHỐI / VFX
local function cleanObject(obj)
    if not obj then return end
    pcall(function()
        -- Giữ lại Sàn AntiVoid
        if obj.Name == "AntiVoidSafetyFloor" then return end
        
        -- Nếu là Nhân vật người chơi -> Dọn phụ kiện & VFX dính kèm
        if Players:GetPlayerFromCharacter(obj) or (obj.Parent and Players:GetPlayerFromCharacter(obj.Parent)) then 
            cleanCharacter(obj)
            return 
        end

        -- Nếu là Khối / Part / Mesh -> Chuyển SmoothPlastic nếu giữ, hoặc Xóa sạch
        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            obj.Material = Enum.Material.SmoothPlastic
        end

        -- Xóa tất cả các hiệu ứng kỹ năng / vfx
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("Beam") then
            obj:Destroy()
            return
        end

        -- Xóa mọi thứ khác trong Workspace (Trừ nhân vật & Sàn)
        if not obj:IsA("Camera") and not obj:IsA("Terrain") then
            obj:Destroy()
        end
    end)
end

-- 5. THỰC THI QUÉT CLEAN MAP
for _, child in ipairs(Workspace:GetChildren()) do
    cleanObject(child)
end

-- Dọn phụ kiện cho tất cả người chơi hiện tại
for _, plr in ipairs(Players:GetPlayers()) do
    if plr.Character then
        cleanCharacter(plr.Character)
    end
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        cleanCharacter(char)
    end)
end

-- 6. TỰ ĐỘNG XÓA KHỐI / VFX MỚI SINH RA TỪ SERVER
Workspace.ChildAdded:Connect(function(child)
    task.wait(0.01)
    cleanObject(child)
end)

-- 7. KHÓA CHỐNG RƠI VOID CHẮC CHẮN (Giữ vị trí Y luôn lớn hơn sàn)
RunService.Stepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            if hrp.Position.Y < -10 then
                hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
                hrp.CFrame = CFrame.new(hrp.Position.X, 5, hrp.Position.Z)
            end
        end
    end
end)
