end)

-- Teleport Xoay Vòng Tròn Quanh Target (Orbit)
RunService.RenderStepped:Connect(function(dt)
    if followActive and targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = targetPlayer.Character.HumanoidRootPart
            local myHRP = myChar.HumanoidRootPart
            
            -- Cập nhật góc xoay dựa trên DeltaTime
            currentAngle = currentAngle + (dt * orbitSpeed)
            
            -- Tính vị trí đón đầu tương lai theo vận tốc
            local targetVelocity = targetHRP.AssemblyLinearVelocity or targetHRP.Velocity
            local predictedCenter = targetHRP.Position + (targetVelocity * leadFactor)
            
            -- Tính tọa độ vòng tròn xung quanh Target
            local offsetX = math.cos(currentAngle) * orbitRadius
            local offsetZ = math.sin(currentAngle) * orbitRadius
            local finalPos = predictedCenter + Vector3.new(offsetX, 0, offsetZ)
            
            -- Quay nhân vật nhìn thẳng vào Target
            myHRP.CFrame = CFrame.lookAt(finalPos, targetHRP.Position)
        end
    end
    
    -- Trả Camera về chế độ mặc định hoàn toàn (Custom)
    local camera = Workspace.CurrentCamera
    if camera.CameraType ~= Enum.CameraType.Custom then
        camera.CameraType = Enum.CameraType.Custom
    end
    local myChar = LocalPlayer.Character
    if myChar and myChar:FindFirstChildOfClass("Humanoid") then
        if camera.CameraSubject ~= myChar:FindFirstChildOfClass("Humanoid") then
            camera.CameraSubject = myChar:FindFirstChildOfClass("Humanoid")
        end
    end
end)

-- Auto Attack M1
task.spawn(function()
    while task.wait(0.08) do
        if autoAttack and targetPlayer and followActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then comm:FireServer({Goal = "LeftClick"}) end
                end
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end
end)

-- Auto Skill (1-4)
task.spawn(function()
    local skillKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local skillIndex = 1
    while task.wait(0.35) do
        if autoAttack and targetPlayer and followActive then
            pcall(function()
                local key = skillKeys[skillIndex]
                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then comm:FireServer({Goal = "KeyPress", Key = key}) end
                end
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.03)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                skillIndex = (skillIndex % 4) + 1
            end)
        end
    end
end)

