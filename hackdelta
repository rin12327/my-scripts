-- Noclip Character R6
RunService.PreRender:Connect(function()
    if noclipActive then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end
end)

-- Teleport Đón Đầu Hitbox + Camera Vuốt Tự Do
RunService.RenderStepped:Connect(function()
    if followActive and targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = targetPlayer.Character.HumanoidRootPart
            local myHRP = myChar.HumanoidRootPart
            
            -- Tính vị trí dự đoán tương lai theo vận tốc chạy của Target (Lead Position)
            local targetVelocity = targetHRP.AssemblyLinearVelocity or targetHRP.Velocity
            local predictedPos = targetHRP.Position + (targetVelocity * leadFactor)
            
            -- Vị trí đứng: Dưới chân vị trí dự đoán để Hitbox vươn chính xác vào mặt
            local finalPos = predictedPos - Vector3.new(0, underDist, 0)
            
            -- Quay mặt bản thân về phía Target
            myHRP.CFrame = CFrame.lookAt(finalPos, targetHRP.Position)
            
            -- CAMERA TỰ DO (Vuốt thoải mái, tự hướng về Target khi xoay)
            local camera = Workspace.CurrentCamera
            if camera.CameraType ~= Enum.CameraType.Custom then
                camera.CameraType = Enum.CameraType.Custom
            end
            camera.CameraSubject = targetPlayer.Character:FindFirstChildOfClass("Humanoid") or myChar:FindFirstChildOfClass("Humanoid")
        end
    else
        local camera = Workspace.CurrentCamera
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChildOfClass("Humanoid") then
            camera.CameraSubject = myChar:FindFirstChildOfClass("Humanoid")
        end
    end
end)

-- Auto Attack M1
task.spawn(function()
    while task.wait(0.08) do
        if autoAttack and targetPlayer and followActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then comm:FireServer({Goal = "LeftClick"}) end
                end
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end
end)

-- Auto Skill (1-4)
task.spawn(function()
    local skillKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local skillIndex = 1
    while task.wait(0.35) do
        if autoAttack and targetPlayer and followActive then
            pcall(function()
                local key = skillKeys[skillIndex]
                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then comm:FireServer({Goal = "KeyPress", Key = key}) end
                end
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.03)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                skillIndex = (skillIndex % 4) + 1
            end)
        end
    end
end)

