-- Noclip triệt để cho Character
RunService.PreRender:Connect(function()
    if noclipActive then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- TELEPORT CỐ ĐỊNH 4 STUDS UNDER + CAMERA LUÔN KHÓA NHÌN VÀO TARGET
RunService.RenderStepped:Connect(function()
    if followActive and targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            local targetHRP = targetPlayer.Character.HumanoidRootPart
            local myHRP = myChar.HumanoidRootPart
            
            -- Vị trí dưới lòng đất: Đặt đúng Under 4 Studs và Behind 0 Studs
            local targetCF = targetHRP.CFrame
            local posBehind = targetCF.Position - (targetCF.LookVector * behindDist)
            local finalPos = posBehind - Vector3.new(0, underDist, 0)
            
            -- Thân nhân vật chĩa thẳng mặt từ dưới lên Target
            myHRP.CFrame = CFrame.lookAt(finalPos, targetHRP.Position)
            
            -- CỐ ĐỊNH CAMERA NHÌN THẲNG VÀO NGƯỜI CHƠI BỊ TARGET
            local camera = Workspace.CurrentCamera
            camera.CameraType = Enum.CameraType.Scriptable
            
            -- Camera lùi về sau lưng Target 7 studs và hơi nhếch lên 2 studs
            local camPos = targetCF.Position - (targetCF.LookVector * 7) + Vector3.new(0, 2, 0)
            camera.CFrame = CFrame.lookAt(camPos, targetHRP.Position)
        end
    else
        -- Trả Camera về bình thường khi ngắt Target
        local camera = Workspace.CurrentCamera
        if camera.CameraType == Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Custom
        end
    end
end)

-- AUTO ATTACK M1 CHO TSB (MƯỢT CẢ MOBILE & PC)
task.spawn(function()
    while task.wait(0.08) do
        if autoAttack and targetPlayer and followActive then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then
                        comm:FireServer({Goal = "LeftClick"})
                    end
                end
                
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end
end)

-- AUTO SKILL (1-4)
task.spawn(function()
    local skillKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local skillIndex = 1
    
    while task.wait(0.35) do
        if autoAttack and targetPlayer and followActive then
            pcall(function()
                local key = skillKeys[skillIndex]
                local char = LocalPlayer.Character
                if char then
                    local comm = char:FindFirstChild("Communicate") or ReplicatedStorage:FindFirstChild("Communicate")
                    if comm then
                        comm:FireServer({Goal = "KeyPress", Key = key})
                    end
                end
                
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.03)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                
                skillIndex = (skillIndex % 4) + 1
            end)
        end
    end
end)
