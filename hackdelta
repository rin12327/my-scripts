local function updateTargetDropdown()
    for _, child in ipairs(TargetScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 25)
            btn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.ZIndex = 11
            btn.Parent = TargetScroll
            
            btn.MouseButton1Click:Connect(function()
                targetPlayer = plr
                TargetDropdownBtn.Text = "🎯 Target: " .. plr.DisplayName
                TargetScroll.Visible = false
            end)
        end
    end
    TargetScroll.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

TargetDropdownBtn.MouseButton1Click:Connect(function()
    updateTargetDropdown()
    TargetScroll.Visible = not TargetScroll.Visible
end)

