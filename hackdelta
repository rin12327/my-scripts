            btn.Parent = TargetScroll
            
            btn.MouseButton1Click:Connect(function()
                targetPlayer = plr
                TargetDropdownBtn.Text = "🎯 Target: " .. plr.DisplayName
                TargetScroll.Visible = false
            end)
        end
    end
    TargetScroll.CanvasSize = UDim2.new(0, 0, 0, count * 25)
end

